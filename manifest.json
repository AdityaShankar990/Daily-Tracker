{
	"manifest_version": 3,
	"name": "Daily Tracker",
	"version": "1.0.0",
	"description": "Local-first productivity app.",
	"icons": {
		"16":  "icons/icon16.png",
		"32":  "icons/icon32.png",
		"48":  "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_popup": "extension-version.html",
		"default_icon": {
			"16":  "icons/icon16.png",
			"32":  "icons/icon32.png",
			"48":  "icons/icon48.png",
			"128": "icons/icon128.png"
		},
		"default_title": "Daily Tracker"
	},
	"permissions": ["storage"],
	"host_permissions": [
		"https://www.googleapis.com/*",
		"https://fonts.googleapis.com/*",
		"https://fonts.gstatic.com/*"
	],
	"content_security_policy": {
		"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://www.googleapis.com; media-src 'self' blob: data:; img-src 'self' data:;"
	}
}